{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "coup-online",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-26",
  "assets": {
    "directory": "./public",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "CoupRoom" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["CoupRoom"] }
  ],
  "observability": {
    "enabled": true
  }
}
